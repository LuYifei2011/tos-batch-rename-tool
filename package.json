{
  "name": "batch-rename",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "npm run test:core && npm run test:server && npm run test:packaging",
    "test:core": "node --experimental-strip-types --test src/core/*.test.ts",
    "test:server": "go test -race -count=1 ./server",
    "test:packaging": "python3 scripts/test-install.py && python3 scripts/test-release.py",
    "bench": "node --experimental-strip-types src/core/benchmark.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "tos-app-core": "https://github.com/LuYifei2011/tos-app-kit/releases/download/v0.3.1/tos-app-core-0.3.1.tgz",
    "tos-app-ui-kit": "https://github.com/LuYifei2011/tos-app-kit/releases/download/v0.3.1/tos-app-ui-kit-0.3.1.tgz",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  },
