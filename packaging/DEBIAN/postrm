#!/bin/bash
set -eu
case "${1:-}" in
remove|purge)
    app=/usr/local/batch-rename
    for name in site site.next site.previous webui webui.next webui.previous; do
        if [ -L "$app/$name" ]; then
            rm -f -- "$app/$name"
        elif [ -d "$app/$name" ]; then
            rm -rf -- "$app/$name"
        fi
    done
    if [ -S /var/api/batch-rename.sock ] || [ -L /var/api/batch-rename.sock ]; then rm -f /var/api/batch-rename.sock; fi
    systemctl daemon-reload
    ;;
esac
# This package script preserves runtime records and user files.
# TOS App Center may separately delete application data when requested.
