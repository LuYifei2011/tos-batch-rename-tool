#!/bin/bash
set -eu
app=/usr/local/batch-rename
case "${1:-}" in
configure)
    for name in data site site.next site.previous webui webui.next webui.previous; do
        if [ -L "$app/$name" ] || { [ -e "$app/$name" ] && [ ! -d "$app/$name" ]; }; then
            echo "batch-rename: $app/$name must be a real directory" >&2
            exit 1
        fi
    done
    # TOS creates the user, potentially after postinst. Prepare the dedicated
    # group now so Group=/SocketGroup= can resolve when TOS enables the app.
    if group_record=$(getent group batch-rename); then
        :
    else
        lookup_status=$?
        if [ "$lookup_status" != 2 ]; then
            echo "batch-rename: group lookup failed ($lookup_status)" >&2
            exit "$lookup_status"
        fi
        groupadd --system batch-rename
        group_record=$(getent group batch-rename)
    fi
    IFS=: read -r group_name group_password group_gid group_members <<< "$group_record"
    case "$group_gid" in
        ''|0|*[!0-9]*) echo "batch-rename: dedicated group must have a non-root GID" >&2; exit 1 ;;
    esac
    # Retire only byte-identical units written by the earlier installer.
    for name in batch-rename.service batch-rename.socket batch-rename-setup.service; do
        if [ "$(systemctl show --property=LoadState --value "$name")" = not-found ]; then continue; fi
        systemctl stop "$name"
        fragment=$(systemctl show --property=FragmentPath --value "$name")
        if [ -f "$fragment" ] && [ ! -L "$fragment" ]; then
            if [ -f "$app/init.d/$name" ] && [ "$fragment" -ef "$app/init.d/$name" ]; then continue; fi
            case "$name" in
                batch-rename.service) expected=ac5b5d1edf2415a077e805802c616d3b27ce10c52be99376ca5c1e370320d14e ;;
                batch-rename.socket) expected=022021d9145442b216d738c61d12b95a519c680716ef7e5bc2d8a03766f1e3cf ;;
                batch-rename-setup.service) expected=6a624bbacc371460d1ee6cc36cba11184232e09592874571b5f68768df68a883 ;;
            esac
            actual=$(sha256sum "$fragment")
            if [ "${actual%% *}" != "$expected" ]; then
                echo "batch-rename: custom unit at $fragment requires manual migration" >&2
                exit 1
            fi
            systemctl disable "$name"
            rm -f -- "$fragment"
        fi
    done
    # Refresh both the backend fallback and TOS static entry on upgrade.
    for name in site webui; do
        if [ -d "$app/$name.previous" ] && [ ! -d "$app/$name" ]; then mv "$app/$name.previous" "$app/$name"; fi
        rm -rf -- "$app/$name.next" "$app/$name.previous"
        install -d -m 0755 "$app/$name.next"
        trap 'rm -rf -- "$app/$name.next"' 0
        tar -xjf "$app/webui.bz2" -C "$app/$name.next"
        if [ ! -f "$app/$name.next/index.html" ]; then
            echo "batch-rename: frontend archive has no index.html" >&2
            exit 1
        fi
        if [ -d "$app/$name" ]; then mv "$app/$name" "$app/$name.previous"; fi
        if ! mv "$app/$name.next" "$app/$name"; then
            if [ -d "$app/$name.previous" ]; then mv "$app/$name.previous" "$app/$name"; fi
            exit 1
        fi
        rm -rf -- "$app/$name.previous"
        trap - 0
    done
    systemctl daemon-reload
    systemctl enable "$app/init.d/batch-rename.service" "$app/init.d/batch-rename.socket"
    if id batch-rename >/dev/null 2>&1; then
        systemctl reset-failed batch-rename.service batch-rename.socket
        systemctl start batch-rename.service
    else
        echo "batch-rename: waiting for TOS to create its application account; enable the app after account creation" >&2
    fi
    ;;
esac
