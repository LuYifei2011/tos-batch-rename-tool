[zh-cn]
name = "批量重命名"
auth = "Lu Yifei"
descript = "预览并批量修改文件名，支持多规则组合、冲突检查、执行记录和撤销。"
release_note = "0.1.2 Beta 新增离线隐私政策和后端来源说明，升级时更新页面并清理旧版页面资源。"
important = ""

[zh-hk]
name = "Batch Rename"
auth = "Lu Yifei"
descript = "Preview and rename files with ordered rules, conflict checks, execution records and undo."
release_note = "0.1.2 Beta adds an offline privacy policy and backend source information. Upgrades refresh the frontend and remove obsolete page assets."
important = ""

